{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "JS Backend API",
    "description": "Complete Postman collection for JS Backend API (Users, Videos, Comments, Likes, Playlists, Subscriptions, Tweets, Dashboard)",
