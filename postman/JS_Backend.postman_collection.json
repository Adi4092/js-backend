  },
  "variable": [
    {
      "key": "server",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullname", "value": "John Doe", "type": "text" },
                { "key": "username", "value": "johndoe", "type": "text" },
                { "key": "email", "value": "john@example.com", "type": "text" },
                { "key": "password", "value": "pass1234", "type": "text" },
                { "key": "avatar", "type": "file", "src": [] },
                { "key": "coverImage", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{server}}/users/register",
              "host": ["{{server}}"],
              "path": ["users", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"password\": \"pass1234\"\n}"
            },
            "url": {
              "raw": "{{server}}/users/login",
              "host": ["{{server}}"],
              "path": ["users", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/users/get-user",
              "host": ["{{server}}"],
              "path": ["users", "get-user"]
            }
          }
        },
        {
          "name": "Logout User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/users/logout",
              "host": ["{{server}}"],
              "path": ["users", "logout"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{server}}/users/refresh-token",
              "host": ["{{server}}"],
              "path": ["users", "refresh-token"]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"pass1234\",\n  \"newPassword\": \"newpass1234\"\n}"
            },
            "url": {
              "raw": "{{server}}/users/change-password",
              "host": ["{{server}}"],
              "path": ["users", "change-password"]
            }
          }
        },
        {
          "name": "Get User Channel Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/users/c/johndoe",
              "host": ["{{server}}"],
              "path": ["users", "c", "johndoe"]
            }
          }
        },
        {
          "name": "Get Watch History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/users/history",
              "host": ["{{server}}"],
              "path": ["users", "history"]
