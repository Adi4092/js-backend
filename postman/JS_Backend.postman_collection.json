    {
      "name": "Videos",
      "item": [
        {
          "name": "Get All Videos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/videos?page=1&limit=10",
              "host": ["{{server}}"],
              "path": ["videos"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Publish A Video",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "My First Video", "type": "text" },
                { "key": "description", "value": "Awesome video content", "type": "text" },
                { "key": "videoFile", "type": "file", "src": [] },
                { "key": "thumbnail", "type": "file", "src": [] }
              ]
            },
            "url": {
              "raw": "{{server}}/videos",
              "host": ["{{server}}"],
              "path": ["videos"]
            }
          }
        },
        {
          "name": "Get Video By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/videos/:videoId",
              "host": ["{{server}}"],
              "path": ["videos", ":videoId"],
              "variable": [{ "key": "videoId", "value": "VIDEO_ID_HERE" }]
            }
          }
        },
        {
          "name": "Toggle Publish Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{server}}/videos/toggle/publish/:videoId",
              "host": ["{{server}}"],
              "path": ["videos", "toggle", "publish", ":videoId"],
              "variable": [{ "key": "videoId", "value": "VIDEO_ID_HERE" }]
            }
          }
        }
      ]
